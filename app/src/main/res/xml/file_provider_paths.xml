<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 的暴露范围。

  只开一个目录：应用外部私有目录下的 `Pictures/pocket-ccd/`，也就是成片的两份副本
  所在的位置（`files/Pictures/pocket-ccd/full` 与 `/thumb`）。

  用途只有一个：详情页的「分享」。`ACTION_SEND` 需要一个 `content://` URI，
  直接把 `file://` 塞进 Intent 会在 API 24+ 抛 `FileUriExposedException`。
  这里用 `path` 限定到 pocket-ccd 子树，而不是整个外部私有目录 —— 越窄越好。
-->
<paths>
    <external-files-path
        name="pocket_ccd"
        path="Pictures/pocket-ccd/" />

    <!--
      D-092：应用内更新下载的安装包（`cacheDir/updates/*.apk`）。

      单独开一个 `cache-path`，而不是把范围扩大到 `cacheDir` 根：这个 provider 只应
      暴露"我们明确要交给外部应用的那个文件"。安装器拿到的是 content:// URI，
      读权限随 Intent 一次性授予，安装完即失效。
    -->
    <cache-path
        name="updates"
        path="updates/" />
</paths>
