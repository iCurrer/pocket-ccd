<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      FOT-007 起申请 CAMERA：预览、拍照都走 CameraX。
      仍然不申请 INTERNET / 存储权限 —— 成片落在应用自己的外部私有目录
      （getExternalFilesDir(Pictures)），不写系统相册，因此不需要任何存储权限。
      没有 READ_MEDIA_IMAGES：照片墙只列本应用自己写的文件。
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- required=false：没有相机的设备（含部分模拟器）仍可安装，运行时降级为静态取景框。 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
      largeHeap：一次 12MP 冲洗要同时持有源 ARGB_8888（48MB）、成品（48MB）
      和分块浮点平面，默认 256MB 的 Java 堆余量太紧。相机/图像类应用开这个
      是常规做法，且它只抬上限、不预留内存。
    -->
    <!--
      icon / roundIcon：此前 <application> 没写 android:icon，装到桌面是系统默认的
      安卓机器人图标。图标是纯矢量 adaptive icon（mipmap-anydpi-v26，minSdk 29 足够），
      不引 PNG、不引第三方图标库。roundIcon 给圆形遮罩的启动器用；两者共用同一套图层。
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketCCD">

        <!--
            D-083：拍摄页强制横版，其他页面竖版 —— 所以方向不能写死在 manifest 里，
            改由 MainActivity 按当前页面设置 requestedOrientation。

            configChanges 必须列全：不加的话每次切换方向都会重建 Activity，
            正在冲洗的那张（6 秒）和相机会话会一起没掉。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|navigation|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          FOT-004 真机自测入口。exported 是为了能用 adb am start 直接拉起，
          Release 构建里会在 onCreate 直接 finish()；没有权限、没有网络、
          也不读写用户媒体文件，只写自己外部私有目录下的一份 JSON。
        -->
        <activity
            android:name=".fotufilm.FilmSelfTestActivity"
            android:exported="true"
            android:label="Fotufilm self test" />

        <!--
          详情页「分享」用。FileProvider 只把 `Pictures/pocket-ccd/` 这一棵子树暴露
          成 content:// URI —— ACTION_SEND 不接受 file://（API 24+ 抛
          FileUriExposedException）。authority 必须与 AppRoot 里拼的字符串一致。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
